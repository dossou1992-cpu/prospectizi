# ------------------------------------------------------------------------------
# 3. LEMON SQUEEZY (Paiements Carte Bancaire Internationale & Factures TVA)
# ------------------------------------------------------------------------------
# Où trouver : lemonsqueezy.com -> Store -> Products -> Share (Checkout Link)
NEXT_PUBLIC_LEMONSQUEEZY_PRO_URL=COLLEZ_ICI_LE_LIEN_CHECKOUT_PRO_29
NEXT_PUBLIC_LEMONSQUEEZY_AGENCE_URL=COLLEZ_ICI_LE_LIEN_CHECKOUT_AGENCE_59
